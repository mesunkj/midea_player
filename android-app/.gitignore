# ==========================================
# Midea Player - Android App .gitignore
# ==========================================

# 1. 依賴套件 (Dependencies)
node_modules/
.pnp
.pnp.js

# 2. 前端編譯產物 (Web Build Outputs)
dist/
dist-ssr/
*.local

# 3. Android APK 與打包二進位檔案 (Binaries & Packages)
*.apk
*.aab
*.ap_
*.dex

# 4. 數位簽名與敏感金鑰 (Keystores & Secrets - 絕不可上傳)
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# 5. 本機特定配置 (Machine-specific configuration)
android/local.properties
.env
.env.local
.env.*.local

# 6. Gradle 快取與原生編譯目錄 (Gradle & Android Build)
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
.externalNativeBuild/
.cxx/

# 7. Capacitor 同步產生的 Web 資源與配置 (Auto-generated by cap sync)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# 8. 編輯器與系統暫存檔 (IDE & OS temporary files)
.idea/
*.iml
.vscode/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
