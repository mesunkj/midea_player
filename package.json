{
  "name": "midea_player",
  "version": "1.1.0",
  "description": "跨平台多視窗圖片輪播系統",
  "main": "./dist/main/index.js",
  "author": "Antigravity",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.antigravity.midea-player",
    "productName": "Midea Player",
    "copyright": "Copyright © 2026 Antigravity",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Midea Player",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "electron": "^25.3.1",
    "electron-builder": "^24.4.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
